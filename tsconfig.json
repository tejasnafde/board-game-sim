{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@board-game-sim/shared": ["packages/shared/src/index.ts"],
      "@board-game-sim/shared/*": ["packages/shared/src/*"],
      "@board-game-sim/engine": ["packages/engine/src/index.ts"],
      "@board-game-sim/engine/*": ["packages/engine/src/*"],
      "@board-game-sim/server": ["packages/server/src/index.ts"],
      "@board-game-sim/server/*": ["packages/server/src/*"],
      "@board-game-sim/battleship": ["packages/games/battleship/src/index.ts"],
      "@board-game-sim/battleship/*": ["packages/games/battleship/src/*"],
      "@board-game-sim/labyrinth": ["packages/games/labyrinth/src/index.ts"],
      "@board-game-sim/labyrinth/*": ["packages/games/labyrinth/src/*"],
      "@board-game-sim/connect4": ["packages/games/connect4/src/index.ts"],
      "@board-game-sim/connect4/*": ["packages/games/connect4/src/*"],
      "@board-game-sim/hex-kingdoms": ["packages/games/hex-kingdoms/src/index.ts"],
      "@board-game-sim/hex-kingdoms/*": ["packages/games/hex-kingdoms/src/*"],
      "@board-game-sim/signal-crew": ["packages/games/signal-crew/src/index.ts"],
      "@board-game-sim/signal-crew/*": ["packages/games/signal-crew/src/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
